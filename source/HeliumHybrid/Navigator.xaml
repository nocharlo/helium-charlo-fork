<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#FF202731">
  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="4"/></Grid.ColumnDefinitions>
  <DockPanel Grid.Column="0" Margin="3,4,2,4">
    <Grid DockPanel.Dock="Top" Margin="0,0,0,3">
      <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions>
      <Button x:Name="CollapseButton" Grid.Column="0" Content="&lt;&lt;" ToolTip="Recolher lista" Padding="0"/>
      <TextBox x:Name="Search" Grid.Column="1" ToolTip="Buscar nesta lista" Padding="3" Margin="2,0"/>
      <Button x:Name="OptionsButton" Grid.Column="2" Content="⚙" ToolTip="Opções da lista e layout" Padding="0"/>
    </Grid>
    <Grid DockPanel.Dock="Top" Margin="0,0,0,3">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <ComboBox x:Name="Grouping" Grid.Column="0" SelectedIndex="0" FontSize="11">
        <ComboBoxItem Content="A–Z"/><ComboBoxItem Content="Série"/>
        <ComboBoxItem Content="Categoria"/><ComboBoxItem Content="Plataforma"/>
      </ComboBox>
      <TextBlock x:Name="Count" Grid.Column="1" Foreground="#FF9BAABA" FontSize="11" Margin="5,0,2,0" VerticalAlignment="Center"/>
    </Grid>
    <TextBlock x:Name="Status" DockPanel.Dock="Bottom" Foreground="#FFC5CED8" TextWrapping="Wrap" FontSize="11"/>
    <ListBox x:Name="Games" Background="Transparent" BorderThickness="0" Foreground="#FFD6DFE8"
        SelectionMode="Single" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
        ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True"
        VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
        VirtualizingPanel.IsVirtualizingWhenGrouping="True">
      <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
      <ListBox.ItemContainerStyle>
        <Style TargetType="ListBoxItem">
          <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="3,2"/>
          <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="RowBorder" Background="Transparent" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Stretch"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="RowBorder" Property="Background" Value="#FF303E4D"/></Trigger>
              <Trigger Property="IsSelected" Value="True"><Setter TargetName="RowBorder" Property="Background" Value="#FF355675"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate></Setter.Value></Setter>
        </Style>
      </ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate><DataTemplate>
        <Grid ToolTip="{Binding Name}"><Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Image Source="{Binding Icon}" Width="16" Height="16" Stretch="Uniform"/>
          <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontSize="12"/>
        </Grid>
      </DataTemplate></ListBox.ItemTemplate>
      <ListBox.GroupStyle><GroupStyle><GroupStyle.ContainerStyle><Style TargetType="GroupItem">
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="GroupItem">
          <Expander IsExpanded="True" Foreground="#FFADBAC8" Margin="0,3,0,1">
            <Expander.Header><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
              <TextBlock Text="{Binding ItemCount, StringFormat=' ({0})'}" Opacity="0.6"/></StackPanel></Expander.Header>
            <ItemsPresenter/>
          </Expander>
        </ControlTemplate></Setter.Value></Setter>
      </Style></GroupStyle.ContainerStyle></GroupStyle></ListBox.GroupStyle>
    </ListBox>
  </DockPanel>
  <Thumb x:Name="ResizeGrip" Grid.Column="1" Cursor="SizeWE" Background="#FF35414D" ToolTip="Arrastar para ajustar a largura">
    <Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="{TemplateBinding Background}"/></ControlTemplate></Thumb.Template>
  </Thumb>
  <Popup x:Name="OptionsPopup" PlacementTarget="{Binding ElementName=OptionsButton}" Placement="Bottom"
      StaysOpen="False" AllowsTransparency="True">
    <Border Background="#FF263442" BorderBrush="#FF597185" BorderThickness="1" Padding="10" Width="255">
      <StackPanel>
        <TextBlock Text="Layout e navegação" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,6"/>
        <ComboBox x:Name="LayoutMode" SelectedIndex="0" Margin="0,0,0,7">
          <ComboBoxItem Content="Automático"/><ComboBoxItem Content="Sempre compacto"/><ComboBoxItem Content="Sempre amplo"/>
        </ComboBox>
        <CheckBox x:Name="SteamMode" Content="Abrir detalhes ao clicar" Foreground="White" Margin="0,0,0,6"/>
        <CheckBox x:Name="LocateCover" Content="Localizar capa no grid" Foreground="White" Margin="0,0,0,6"/>
        <CheckBox x:Name="PreserveScroll" Content="Restaurar rolagem ao voltar" Foreground="White"/>
      </StackPanel>
    </Border>
  </Popup>
</Grid>
