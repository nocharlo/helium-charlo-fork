<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:HeliumHybrid;assembly=HeliumCharlo" Background="#FF202731">
  <Grid.Resources>
    <Style x:Key="QuickButtonStyle" TargetType="Button">
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Face" Background="{TemplateBinding Background}" BorderBrush="#FF435568" BorderThickness="1" CornerRadius="2">
          <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Background" Value="#FF42617D"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Grid.Resources>
  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="5"/></Grid.ColumnDefinitions>
  <DockPanel x:Name="MainPanel" Grid.Column="0" Margin="3,3,2,3">
    <StackPanel x:Name="Tools" DockPanel.Dock="Top">
      <Grid Margin="0,0,0,5">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="33"/><ColumnDefinition Width="33"/><ColumnDefinition Width="29"/></Grid.ColumnDefinitions>
        <Button x:Name="BackButton" Grid.Column="0" Style="{StaticResource QuickButtonStyle}" HorizontalContentAlignment="Stretch" Height="28" Margin="0,0,3,0" ToolTip="Back to Grid" Background="#FF293747" Foreground="#FFDAE4EE">
          <Grid Margin="8,0"><TextBlock Text="Games" HorizontalAlignment="Left" VerticalAlignment="Center"/>
            <Path HorizontalAlignment="Right" VerticalAlignment="Center" Fill="#FFB9CBDC" Data="M0,0 L8,0 L4,4 Z" Width="8" Height="4" Stretch="Fill"/></Grid>
        </Button>
        <Button x:Name="RecentButton" Grid.Column="1" Style="{StaticResource QuickButtonStyle}" Width="30" Height="28" Margin="0,0,3,0" ToolTip="Toggle Recent Activity" Background="#FF293747" Foreground="#FFB9CBDC">
          <Viewbox Width="17" Height="17"><Grid Width="20" Height="20"><Ellipse Margin="1" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2"/><Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" Data="M10,4 V10 L14,12"/></Grid></Viewbox>
        </Button>
        <Button x:Name="ReadyButton" Grid.Column="2" Style="{StaticResource QuickButtonStyle}" Width="30" Height="28" Margin="0,0,3,0" ToolTip="Ready to Play: installed games" Background="#FF293747" Foreground="#FFB9CBDC">
          <Viewbox Width="14" Height="15"><Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="M2,1 L14,8 L2,15 Z"/></Viewbox>
        </Button>
        <Button x:Name="CollapseButton" Grid.Column="3" Style="{StaticResource QuickButtonStyle}" Width="26" Height="28" ToolTip="Collapse the Navigator" Background="#FF293747" Foreground="#FFB9CBDC">
          <Viewbox Width="15" Height="15"><Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" Data="M12,1 L5,8 L12,15"/></Viewbox>
        </Button>
      </Grid>
      <Grid Margin="0,0,0,4">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions>
        <Grid Grid.Column="0" Margin="0,0,3,0">
          <TextBox x:Name="Search" ToolTip="Search by Name (global filters still apply)" Padding="24,3,4,3"/>
          <Path IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="7,0,0,0" Stroke="#FF9BAABA" StrokeThickness="2" Data="M12,7 A5,5 0 1 1 2,7 A5,5 0 1 1 12,7 M11,11 L16,16" Width="17" Height="17" Stretch="Fill"/>
        </Grid>
        <Button x:Name="FiltersButton" Grid.Column="1" Style="{StaticResource QuickButtonStyle}" Width="29" Height="26" ToolTip="Advanced Filters" Background="#FF293747" Foreground="#FFE0EBF7">
          <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" Data="M1,2 H18 M5,8 H18 M9,14 H18" Width="18" Height="16" Stretch="Fill"/>
        </Button>
      </Grid>
      <TextBlock x:Name="FilterIndicator" Foreground="#FF78B9E7" FontSize="11" Margin="3,0,0,3"/>
      <ComboBox x:Name="Grouping" SelectedIndex="0" Margin="0,0,0,3">
        <ComboBoxItem Content="Native / alphabetical"/><ComboBoxItem Content="Series"/>
        <ComboBoxItem Content="Category / collection"/><ComboBoxItem Content="Platform"/>
        <ComboBoxItem Content="Recent Activity"/>
      </ComboBox>
      <TextBlock x:Name="Count" Foreground="#FF9BAABA" FontSize="11" Margin="3,0,0,3"/>
    </StackPanel>
    <TextBlock x:Name="Status" DockPanel.Dock="Bottom" Foreground="#FFC5CED8" TextWrapping="Wrap" FontSize="11"/>
    <Grid>
    <ListBox x:Name="Games" Background="Transparent" BorderThickness="0" Foreground="#FFD6DFE8"
        SelectionMode="Single" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
        ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True"
        VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
        VirtualizingPanel.IsVirtualizingWhenGrouping="True">
      <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
      <ListBox.ItemContainerStyle>
        <Style TargetType="ListBoxItem">
          <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="4,3"/>
          <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="RowBorder" Background="Transparent" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Stretch"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="RowBorder" Property="Background" Value="#FF303E4D"/></Trigger>
              <Trigger Property="IsSelected" Value="True"><Setter TargetName="RowBorder" Property="Background" Value="#FF355675"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate></Setter.Value></Setter>
        </Style>
      </ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate><DataTemplate>
        <Grid ToolTip="{Binding Name}"><Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/></Grid.ColumnDefinitions>
          <Image Source="{Binding Icon}" Width="16" Height="16" Stretch="Uniform"/>
          <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontSize="12">
            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#FFA3AAB9"/><Style.Triggers>
              <DataTrigger Binding="{Binding IsInstalled}" Value="True"><Setter Property="Foreground" Value="#FFF1F7FF"/></DataTrigger>
              <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter Property="Foreground" Value="#FFF1F7FF"/></DataTrigger>
              <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter Property="Foreground" Value="#FFF1F7FF"/></DataTrigger>
            </Style.Triggers></Style></TextBlock.Style>
          </TextBlock>
          <TextBlock Grid.Column="2" Text="★" Foreground="#FF67B3FF" FontSize="10" VerticalAlignment="Center" ToolTip="Favorite">
            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Favorite}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
          </TextBlock>
        </Grid>
      </DataTemplate></ListBox.ItemTemplate>
      <ListBox.GroupStyle><GroupStyle>
        <GroupStyle.ContainerStyle><Style TargetType="GroupItem">
          <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="GroupItem">
            <local:NavigatorGroupExpander IsExpanded="True" Foreground="#FFADBAC8" Margin="0,5,0,1">
              <Expander.Header><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding ItemCount, StringFormat=' ({0})'}" Opacity="0.6"/></StackPanel></Expander.Header>
              <ItemsPresenter/>
            </local:NavigatorGroupExpander>
          </ControlTemplate></Setter.Value></Setter>
        </Style></GroupStyle.ContainerStyle>
      </GroupStyle></ListBox.GroupStyle>
    </ListBox>
    <ScrollViewer x:Name="AdvancedPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="#FF202731">
      <StackPanel Margin="4,3,5,8">
        <TextBlock Text="Advanced Filters" FontWeight="SemiBold" Foreground="#FFF1F7FF" FontSize="14" Margin="0,0,0,7"/>
        <Button x:Name="CloseFilters" Content="Back to library" HorizontalContentAlignment="Left" Padding="5,3" Margin="0,0,0,5"/>
        <Button x:Name="ClearAllFilters" Content="Clear All Filters" HorizontalContentAlignment="Left" Padding="5,3" Margin="0,0,0,7"/>
        <StackPanel x:Name="FilterSections"/>
      </StackPanel>
    </ScrollViewer>
    </Grid>
  </DockPanel>
  <Thumb x:Name="ResizeGrip" Grid.Column="1" Cursor="SizeWE" Background="#FF35414D" ToolTip="Drag to resize the sidebar">
    <Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="{TemplateBinding Background}"/></ControlTemplate></Thumb.Template>
  </Thumb>
</Grid>
