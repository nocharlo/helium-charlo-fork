<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:HeliumHybrid;assembly=HeliumCharlo" Background="#FF202731">
  <Grid.Resources>
    <SolidColorBrush x:Key="SteamIconBrush" Color="#FF9B9DA1"/>
    <SolidColorBrush x:Key="SteamActiveBrush" Color="#FFB7CBE0"/>
    <SolidColorBrush x:Key="SteamTextBrush" Color="#FFC0C2C5"/>
    <SolidColorBrush x:Key="SteamMutedBrush" Color="#FF92969D"/>
    <Style x:Key="ToolbarButtonStyle" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource SteamIconBrush}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Face" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="3">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Background" Value="#FF343840"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="Face" Property="Background" Value="#FF303640"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="#FF667583"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="HomeButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolbarButtonStyle}">
      <Setter Property="Background" Value="#FF363940"/>
      <Setter Property="Foreground" Value="{StaticResource SteamTextBrush}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Face" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="3">
          <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Background" Value="#FF41454B"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="Face" Property="Background" Value="#FF303640"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="#FF667583"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="QuietGroupingStyle" TargetType="ComboBox">
      <Setter Property="Foreground" Value="{StaticResource SteamTextBrush}"/>
      <Setter Property="Background" Value="#FF25272C"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
        <Grid>
          <ToggleButton x:Name="DropToggle" Focusable="False" ClickMode="Press" BorderBrush="Transparent"
                        IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
              <Border x:Name="Face" Background="#FF25272C" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="3">
                <Grid>
                  <ContentPresenter Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                    ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                    Margin="7,0,25,0" VerticalAlignment="Center"/>
                  <Viewbox Width="11" Height="11" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Canvas Width="24" Height="24"><Path Data="M6,9 L12,15 L18,9" Fill="Transparent" Stroke="{StaticResource SteamIconBrush}" StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Canvas>
                  </Viewbox>
                </Grid>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Background" Value="#FF343840"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="#FF667583"/></Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate></ToggleButton.Template>
          </ToggleButton>
          <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" StaysOpen="True">
            <Border Background="#FF25272C" BorderBrush="#FF41454D" BorderThickness="1" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="300">
              <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer>
            </Border>
          </Popup>
        </Grid>
        <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="DropToggle" Property="BorderBrush" Value="#FF667583"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Grid.Resources>
  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="5"/></Grid.ColumnDefinitions>
  <DockPanel x:Name="MainPanel" Grid.Column="0" Margin="3,3,2,3">
    <StackPanel x:Name="Tools" DockPanel.Dock="Top">
      <Grid Height="36" Margin="5,0,5,7">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="29"/><ColumnDefinition Width="29"/><ColumnDefinition Width="13"/></Grid.ColumnDefinitions>
        <Button x:Name="HomeButton" Grid.Column="0" Style="{StaticResource HomeButtonStyle}" Height="36" Margin="0,0,3,0" ToolTip="Home: back to Grid">
          <Grid><TextBlock Text="Home" FontSize="14" FontWeight="SemiBold" Foreground="#FFC8CCD2" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="9,0,31,0"/>
            <Viewbox Width="19" Height="19" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,7,0" IsHitTestVisible="False"><Canvas Width="24" Height="24">
              <Rectangle Canvas.Left="4" Canvas.Top="4" Width="7" Height="7" RadiusX="0.8" RadiusY="0.8" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
              <Rectangle Canvas.Left="13" Canvas.Top="4" Width="7" Height="7" RadiusX="0.8" RadiusY="0.8" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
              <Rectangle Canvas.Left="4" Canvas.Top="13" Width="7" Height="7" RadiusX="0.8" RadiusY="0.8" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
              <Rectangle Canvas.Left="13" Canvas.Top="13" Width="7" Height="7" RadiusX="0.8" RadiusY="0.8" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
            </Canvas></Viewbox>
          </Grid>
        </Button>
        <Button x:Name="RecentButton" Grid.Column="1" Style="{StaticResource ToolbarButtonStyle}" Width="27" Height="27" ToolTip="Toggle Recent Activity">
          <Viewbox Width="19" Height="19"><Canvas Width="24" Height="24">
            <Ellipse Canvas.Left="3" Canvas.Top="3" Width="18" Height="18" Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2"/>
            <Path Data="M12,6.5 L12,12 L15.8,15" Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
          </Canvas></Viewbox>
        </Button>
        <Button x:Name="ReadyButton" Grid.Column="2" Style="{StaticResource ToolbarButtonStyle}" Width="27" Height="27" ToolTip="Ready to Play: installed games">
          <Viewbox Width="19" Height="19"><Canvas Width="24" Height="24">
            <Ellipse Canvas.Left="3" Canvas.Top="3" Width="18" Height="18" Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2"/>
            <Path Data="M10,8 L16.4,12 L10,16 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
          </Canvas></Viewbox>
        </Button>
        <Button x:Name="CollapseButton" Grid.Column="3" Style="{StaticResource ToolbarButtonStyle}" Width="13" Height="23" Foreground="#FF666B72" ToolTip="Collapse the Navigator">
          <Viewbox Width="10" Height="10"><Canvas Width="24" Height="24"><Path Data="M15,6 L9,12 L15,18" Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Canvas></Viewbox>
        </Button>
      </Grid>
      <Border Height="37" Margin="5,0,5,4" Background="#FF24262B" BorderThickness="1" CornerRadius="3">
        <Border.Style><Style TargetType="Border"><Setter Property="BorderBrush" Value="Transparent"/><Style.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="#FF667583"/></Trigger></Style.Triggers></Style></Border.Style>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions>
          <Viewbox Grid.Column="0" Width="21" Height="21" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"><Canvas Width="24" Height="24">
            <Ellipse Canvas.Left="3" Canvas.Top="3" Width="14" Height="14" Fill="Transparent" Stroke="{StaticResource SteamIconBrush}" StrokeThickness="2.3"/>
            <Path Data="M15.5,15.5 L21,21" Stroke="{StaticResource SteamIconBrush}" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
          </Canvas></Viewbox>
          <TextBox x:Name="Search" Grid.Column="1" ToolTip="Search by Name (global filters still apply)" Background="Transparent" BorderThickness="0" Foreground="{StaticResource SteamTextBrush}" CaretBrush="{StaticResource SteamTextBrush}" Padding="0,7,2,4" VerticalContentAlignment="Center"/>
          <TextBlock Grid.Column="1" Text="Search by name" Foreground="{StaticResource SteamMutedBrush}" VerticalAlignment="Center" IsHitTestVisible="False">
            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=Search}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
          </TextBlock>
          <Button x:Name="FiltersButton" Grid.Column="2" Style="{StaticResource ToolbarButtonStyle}" Width="31" Height="32" ToolTip="Advanced Filters">
            <Viewbox Width="20" Height="20"><Canvas Width="24" Height="24"><Path Data="M2.5,6.5 L21.5,6.5 M5.5,12 L18.5,12 M8.5,17.5 L15.5,17.5" Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2.5" StrokeStartLineCap="Flat" StrokeEndLineCap="Flat"/></Canvas></Viewbox>
          </Button>
          <TextBlock x:Name="FilterIndicator" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,1,1,0" Foreground="#FF78B9E7" FontSize="9" IsHitTestVisible="False"/>
        </Grid>
      </Border>
      <Button x:Name="SortGroupButton" Height="42" Margin="5,0,5,2" Background="#FF25272C" Foreground="#FFE5EAF1" BorderThickness="0" HorizontalContentAlignment="Stretch" ToolTip="Sort and group games">
        <Grid Margin="7,2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/></Grid.ColumnDefinitions>
          <StackPanel><TextBlock Text="Sort &amp; Group" FontSize="12" FontWeight="SemiBold"/><TextBlock x:Name="SortSummary" Foreground="#FFA5B0BD" FontSize="10" TextTrimming="CharacterEllipsis"/></StackPanel>
          <Path Grid.Column="1" Data="M2,3 L7,8 L12,3" Stroke="#FFA5B0BD" StrokeThickness="1.7" Fill="Transparent" VerticalAlignment="Center"/>
        </Grid>
      </Button>
      <Popup x:Name="SortGroupPopup" Placement="Right" PlacementTarget="{Binding ElementName=SortGroupButton}" HorizontalOffset="5" StaysOpen="False" AllowsTransparency="True" Focusable="False">
        <Border Width="310" Background="#FF30343D" BorderBrush="#FF48515E" BorderThickness="1" CornerRadius="5" Padding="12">
          <Border.Resources>
            <Style TargetType="RadioButton"><Setter Property="Foreground" Value="#FFE5EAF1"/><Setter Property="Margin" Value="0,2"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
              <Border x:Name="Face" Background="#FF363B44" BorderBrush="Transparent" BorderThickness="1" CornerRadius="3" Padding="7,5"><StackPanel Orientation="Horizontal"><Ellipse Width="12" Height="12" Stroke="#FFA5B0BD" StrokeThickness="1.5" Margin="0,0,7,0"><Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="Transparent"/><Style.Triggers><DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}}" Value="True"><Setter Property="Fill" Value="#FF56B8F4"/></DataTrigger></Style.Triggers></Style></Ellipse.Style></Ellipse><ContentPresenter/></StackPanel></Border>
              <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Face" Property="Background" Value="#FF405773"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="#FF64788C"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="#FF8FC8EE"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter></Style>
          </Border.Resources>
          <StackPanel>
            <DockPanel><TextBlock Text="SORT &amp; GROUP" Foreground="#FFE5EAF1" FontWeight="SemiBold" FontSize="12" DockPanel.Dock="Left"/><Button x:Name="SortClose" Content="×" DockPanel.Dock="Right" Width="24" Height="23" Background="Transparent" BorderThickness="0" Foreground="#FFE5EAF1"/></DockPanel>
            <TextBlock Text="GROUP BY" Foreground="#FF56B8F4" FontWeight="SemiBold" FontSize="10" Margin="0,10,0,3"/>
            <UniformGrid Columns="2"><RadioButton x:Name="GroupNative" Content="Native" GroupName="NavigatorGroup" Tag="0"/><RadioButton x:Name="GroupSeries" Content="Series" GroupName="NavigatorGroup" Tag="1"/><RadioButton x:Name="GroupCategory" Content="Category" GroupName="NavigatorGroup" Tag="2"/><RadioButton x:Name="GroupPlatform" Content="Platform" GroupName="NavigatorGroup" Tag="3"/></UniformGrid>
            <Border Height="1" Background="#FF48515E" Margin="0,9,0,0"/>
            <TextBlock Text="SORT BY" Foreground="#FF56B8F4" FontWeight="SemiBold" FontSize="10" Margin="0,9,0,3"/>
            <RadioButton x:Name="SortNative" Content="Following Playnite" GroupName="NavigatorSort" Tag="0" ToolTip="Use the current Playnite library order"/>
            <UniformGrid Columns="2"><RadioButton x:Name="SortName" Content="Name" GroupName="NavigatorSort" Tag="1"/><RadioButton x:Name="SortLastPlayed" Content="Last Played" GroupName="NavigatorSort" Tag="2"/><RadioButton x:Name="SortPlaytime" Content="Playtime" GroupName="NavigatorSort" Tag="3"/><RadioButton x:Name="SortReleaseDate" Content="Release Date" GroupName="NavigatorSort" Tag="4"/></UniformGrid>
            <Border Height="1" Background="#FF48515E" Margin="0,9,0,0"/>
            <TextBlock Text="ORDER" Foreground="#FF56B8F4" FontWeight="SemiBold" FontSize="10" Margin="0,9,0,3"/>
            <UniformGrid Columns="2"><RadioButton x:Name="OrderAscending" Content="↑ Ascending" GroupName="NavigatorOrder"/><RadioButton x:Name="OrderDescending" Content="↓ Descending" GroupName="NavigatorOrder"/></UniformGrid>
            <Button x:Name="SortDone" Content="Done" HorizontalAlignment="Right" Margin="0,10,0,0" Padding="14,4" Background="#FF405773" Foreground="#FFE5EAF1" BorderThickness="0"/>
          </StackPanel>
        </Border>
      </Popup>
      <ComboBox x:Name="Grouping" Visibility="Collapsed" SelectedIndex="0">
        <ComboBoxItem Content="Native / alphabetical"/><ComboBoxItem Content="Series"/>
        <ComboBoxItem Content="Category / collection"/><ComboBoxItem Content="Platform"/>
        <ComboBoxItem Content="Recent Activity"/>
      </ComboBox>
      <TextBlock x:Name="Count" Foreground="{StaticResource SteamMutedBrush}" FontSize="11" Margin="7,0,0,3"/>
    </StackPanel>
    <TextBlock x:Name="Status" DockPanel.Dock="Bottom" Foreground="#FFC5CED8" TextWrapping="Wrap" FontSize="11"/>
    <Grid>
    <ListBox x:Name="Games" Background="Transparent" BorderThickness="0" Foreground="#FFD6DFE8"
        SelectionMode="Single" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
        ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True"
        VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
        VirtualizingPanel.IsVirtualizingWhenGrouping="True">
      <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
      <ListBox.ItemContainerStyle>
        <Style TargetType="ListBoxItem">
          <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="4,3"/>
          <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="RowBorder" Background="Transparent" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Stretch"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="RowBorder" Property="Background" Value="#FF303E4D"/></Trigger>
              <Trigger Property="IsSelected" Value="True"><Setter TargetName="RowBorder" Property="Background" Value="#FF355675"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate></Setter.Value></Setter>
        </Style>
      </ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate><DataTemplate>
        <Grid ToolTip="{Binding Name}"><Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/></Grid.ColumnDefinitions>
          <Image Source="{Binding Icon}" Width="16" Height="16" Stretch="Uniform"/>
          <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontSize="12">
            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#FFA3AAB9"/><Style.Triggers>
              <DataTrigger Binding="{Binding IsInstalled}" Value="True"><Setter Property="Foreground" Value="#FFF1F7FF"/></DataTrigger>
              <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter Property="Foreground" Value="#FFF1F7FF"/></DataTrigger>
              <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter Property="Foreground" Value="#FFF1F7FF"/></DataTrigger>
            </Style.Triggers></Style></TextBlock.Style>
          </TextBlock>
          <TextBlock Grid.Column="2" Text="★" Foreground="#FF67B3FF" FontSize="10" VerticalAlignment="Center" ToolTip="Favorite">
            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Favorite}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
          </TextBlock>
        </Grid>
      </DataTemplate></ListBox.ItemTemplate>
      <ListBox.GroupStyle><GroupStyle>
        <GroupStyle.ContainerStyle><Style TargetType="GroupItem">
          <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="GroupItem">
            <local:NavigatorGroupExpander IsExpanded="True" Foreground="#FFADBAC8" Margin="0,5,0,1">
              <Expander.Header><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding ItemCount, StringFormat=' ({0})'}" Opacity="0.6"/></StackPanel></Expander.Header>
              <ItemsPresenter/>
            </local:NavigatorGroupExpander>
          </ControlTemplate></Setter.Value></Setter>
        </Style></GroupStyle.ContainerStyle>
      </GroupStyle></ListBox.GroupStyle>
    </ListBox>
    <ScrollViewer x:Name="AdvancedPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="#FF202731">
      <StackPanel Margin="4,3,5,8">
        <TextBlock Text="Advanced Filters" FontWeight="SemiBold" Foreground="#FFF1F7FF" FontSize="14" Margin="0,0,0,7"/>
        <Button x:Name="CloseFilters" Content="Back to library" HorizontalContentAlignment="Left" Padding="5,3" Margin="0,0,0,5"/>
        <Button x:Name="ClearAllFilters" Content="Clear All Filters" HorizontalContentAlignment="Left" Padding="5,3" Margin="0,0,0,7"/>
        <StackPanel x:Name="FilterSections"/>
      </StackPanel>
    </ScrollViewer>
    </Grid>
  </DockPanel>
  <Thumb x:Name="ResizeGrip" Grid.Column="1" Cursor="SizeWE" Background="#FF35414D" ToolTip="Drag to resize the sidebar">
    <Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="{TemplateBinding Background}"/></ControlTemplate></Thumb.Template>
  </Thumb>
</Grid>
