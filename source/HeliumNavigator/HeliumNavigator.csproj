<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net462</TargetFramework><LangVersion>7.3</LangVersion>
    <AssemblyName>HeliumCharlo</AssemblyName><RootNamespace>HeliumNavigator</RootNamespace><GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
  </PropertyGroup>
  <!-- Release packages must not embed developer-machine PDB paths. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="PlayniteSDK" Version="6.19.0" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net462" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="PresentationCore" /><Reference Include="PresentationFramework" />
    <Reference Include="WindowsBase" /><Reference Include="System.Xaml" />
    <Reference Include="System.Windows.Forms" /><Reference Include="System.Drawing" />
    <Compile Remove="obj/**/*.cs" />
    <EmbeddedResource Include="Navigator.xaml" />
  </ItemGroup>
</Project>
